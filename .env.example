# Copy this file to .env and replace the placeholder password before starting PostgreSQL.
DB_NAME=eventflow
DB_USERNAME=eventflow_app
DB_PASSWORD=replace-with-a-long-local-password
DB_PORT=5432

# Optional SMTP settings for email verification. Gmail requires an App Password.
MAIL_ENABLED=false
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS=true
APP_BASE_URL=http://localhost:5173
